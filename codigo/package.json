{
  "name": "central-da-familia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:exemplo": "vite --mode exemplo",
    "build": "tsc -p . && vite build",
    "build:exemplo": "vite build --mode exemplo",
    "build:demo": "vite build --mode demo && node scripts/demo.mjs",
    "test": "vitest run",
    "portoes": "node scripts/portoes.mjs",
    "teste:falha": "vite build && node testes/falha.cjs",
    "e2e": "node testes/e2e.mjs",
    "teste:final": "vite build --mode exemplo && node testes/varredura3.cjs",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "decimal.js": "10.4.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
